# ===== Обязательно заполнить =====
# Пароль PostgreSQL (метаданные Airflow)
POSTGRES_PASSWORD=change-me
# Пароль администратора Airflow UI
AIRFLOW_ADMIN_PASSWORD=change-me

# ===== Опционально =====
AIRFLOW_ADMIN_USER=admin
AIRFLOW_WEBSERVER_PORT=8080
# UID внутри контейнеров Airflow; на Linux обычно id -u, по умолчанию 50000
AIRFLOW_UID=50000

# Секретный ключ webserver (сгенерируйте: python -c "import secrets; print(secrets.token_hex(16))")
AIRFLOW_WEBSERVER_SECRET_KEY=
# Fernet-ключ для шифрования соединений (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW_FERNET_KEY=

# ===== Сбор Telegram (snscrape, публичный веб-интерфейс t.me) =====
TG_MAX_PARALLEL_CHANNELS=4
TG_REQUEST_TIMEOUT=30
TG_OVERLAP_SIZE=10

# ===== Superset =====
SUPERSET_SECRET_KEY=  # python -c "import secrets; print(secrets.token_hex(32))"
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change-me
SUPERSET_PORT=8088
